    sh:targetClass <https://permitgraph.dev/spec/model/core/ChemicalHolding> ;
.

<https://permitgraph.dev/spec/model/core/Correspondence>
    a sh:NodeShape ;
    rdfs:comment "A published crosswalk between two scheme versions, as an addressable and versionable object rather than a lookup table." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property 
        [
            sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path <https://permitgraph.dev/spec/model/core/published_on> ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path <https://permitgraph.dev/spec/model/core/coverage_notes> ;
        ] ,
        [
