        [
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path <https://permitgraph.dev/spec/model/core/title> ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Synthetic key. The natural key is (scheme, vintage, code)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <https://permitgraph.dev/spec/model/core/id> ;
        ] ,
        [
            sh:class <https://permitgraph.dev/spec/model/core/SchemeVersion> ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
