        ] ,
        [
            sh:in (
                "unconfirmed"
                "owner_confirmed"
                "staff_confirmed"
                "agency_assigned"
            ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 8 ;
            sh:path <https://permitgraph.dev/spec/model/core/confirmation_state> ;
        ] ,
        [
            sh:class <https://permitgraph.dev/spec/model/core/SchemeVersion> ;
            sh:maxCount 1 ;
