PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<https://permitgraph.dev/spec/model/core/CodeTranslation>
    a sh:NodeShape ;
    rdfs:comment "The result of walking one or more correspondences. The hop path is retained so a translation can be audited rather than trusted." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property 
        [
            sh:datatype xsd:boolean ;
            sh:description "True only when every hop is an exactMatch. Close-match chains never auto-compose." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path <https://permitgraph.dev/spec/model/core/is_composable> ;
        ] ,
        [
            sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path <https://permitgraph.dev/spec/model/core/review_required> ;
        ] ,
        [
            sh:in (
                skos:exactMatch
                skos:closeMatch
                skos:broadMatch
                skos:narrowMatch
                skos:relatedMatch
            ) ;
            sh:order 5 ;
            sh:path <https://permitgraph.dev/spec/model/core/match_type_chain> ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path <https://permitgraph.dev/spec/model/core/result_code> ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <https://permitgraph.dev/spec/model/core/id> ;
        ] ,
        [
            sh:class <https://permitgraph.dev/spec/model/core/SchemeVersion> ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path <https://permitgraph.dev/spec/model/core/target_scheme_version> ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Ordered correspondence identifiers." ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path <https://permitgraph.dev/spec/model/core/hop_path> ;
        ] ,
        [
            sh:class <https://permitgraph.dev/spec/model/core/ClassificationAssignment> ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path <https://permitgraph.dev/spec/model/core/assignment> ;
        ] ;
    sh:targetClass <https://permitgraph.dev/spec/model/core/CodeTranslation> ;
.

<https://permitgraph.dev/spec/model/core/ConceptMapping>
    a sh:NodeShape ;
    rdfs:comment "One row of a correspondence." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property 
        [
            sh:in (
                skos:exactMatch
                skos:closeMatch
                skos:broadMatch
                skos:narrowMatch
                skos:relatedMatch
            ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 4 ;
            sh:path <https://permitgraph.dev/spec/model/core/match_type> ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path <https://permitgraph.dev/spec/model/core/asserted_by> ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <https://permitgraph.dev/spec/model/core/id> ;
        ] ,
        [
            sh:class <https://permitgraph.dev/spec/model/core/Concept> ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path <https://permitgraph.dev/spec/model/core/source_concept> ;
        ] ,
        [
            sh:class <https://permitgraph.dev/spec/model/core/Concept> ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path <https://permitgraph.dev/spec/model/core/target_concept> ;
        ] ,
        [
            sh:datatype xsd:decimal ;
            sh:description "Local extension. XKOS 1.2 defines no such property." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path <https://permitgraph.dev/spec/model/core/apportionment_ratio> ;
        ] ,
        [
            sh:datatype xsd:decimal ;
            sh:description "Local extension." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path <https://permitgraph.dev/spec/model/core/match_strength> ;
        ] ,
        [
            sh:class <https://permitgraph.dev/spec/model/core/Correspondence> ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path <https://permitgraph.dev/spec/model/core/correspondence> ;
        ] ;
    sh:targetClass <https://permitgraph.dev/spec/model/core/ConceptMapping> ;
.

<https://permitgraph.dev/spec/model/core/CredentialDependencyEdge>
    a sh:NodeShape ;
    rdfs:comment "A derived, typed edge used for topological ordering. Cycles are a transcription error in the source law and fail CI; they are not a runtime condition to handle." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property 
        [
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <https://permitgraph.dev/spec/model/core/id> ;
        ] ,
        [
            sh:class <https://permitgraph.dev/spec/model/core/Requirement> ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path <https://permitgraph.dev/spec/model/core/derived_from_requirement> ;
        ] ,
        [
            sh:class <https://permitgraph.dev/spec/model/core/Credential> ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path <https://permitgraph.dev/spec/model/core/to_credential> ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path <https://permitgraph.dev/spec/model/core/edge_kind> ;
        ] ,
        [
            sh:class <https://permitgraph.dev/spec/model/core/Credential> ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path <https://permitgraph.dev/spec/model/core/from_credential> ;
        ] ;
    sh:targetClass <https://permitgraph.dev/spec/model/core/CredentialDependencyEdge> ;
.

<https://permitgraph.dev/spec/model/core/Determination>
    a sh:NodeShape ;
    rdfs:comment "A reproducible answer. Pinning the rule version, the law date, and a hash of the inputs is what lets the system answer \"why did it say that in March\"." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property 
        [
            sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path <https://permitgraph.dev/spec/model/core/determined_at> ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "The predicate tree annotated with truth values and citations." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path <https://permitgraph.dev/spec/model/core/evidence_tree> ;
        ] ,
        [
            sh:in (
                "TRUE"
                "FALSE"
                "UNKNOWN_MISSING_INPUT"
                "UNKNOWN_NOT_SELF_DETERMINABLE"
            ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 4 ;
            sh:path <https://permitgraph.dev/spec/model/core/result> ;
        ] ,
        [
            sh:in (
                "business"
                "establishment"
                "process"
                "activity"
            ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 2 ;
            sh:path <https://permitgraph.dev/spec/model/core/subject_scope> ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <https://permitgraph.dev/spec/model/core/id> ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path <https://permitgraph.dev/spec/model/core/engine_version> ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path <https://permitgraph.dev/spec/model/core/rule_version_id> ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path <https://permitgraph.dev/spec/model/core/subject_ref> ;
        ] ,
        [
            sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path <https://permitgraph.dev/spec/model/core/as_of_law> ;
        ] ,
        [
            sh:class <https://permitgraph.dev/spec/model/core/AttributeDefinition> ;
            sh:description "What must be answered next when the result is indeterminate." ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path <https://permitgraph.dev/spec/model/core/missing_attributes> ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path <https://permitgraph.dev/spec/model/core/input_snapshot_hash> ;
        ] ,
        [
            sh:class <https://permitgraph.dev/spec/model/core/ClassificationAssignment> ;
            sh:description "MUST reference an assignment whose confirmation_state is not `unconfirmed`. Enforced by a database CHECK constraint, not by application code." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path <https://permitgraph.dev/spec/model/core/classification_assignment> ;
        ] ,
        [
            sh:class <https://permitgraph.dev/spec/model/core/Obligation> ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path <https://permitgraph.dev/spec/model/core/obligation> ;
        ] ;
    sh:targetClass <https://permitgraph.dev/spec/model/core/Determination> ;
.

<https://permitgraph.dev/spec/model/core/Fact>
    a sh:NodeShape ;
    rdfs:comment "An open-world fact carrying the long tail of attributes that do not warrant a typed column." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property 
        [
            sh:in (
                "business"
                "establishment"
                "process"
                "activity"
            ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 2 ;
            sh:path <https://permitgraph.dev/spec/model/core/subject_scope> ;
        ] ,
        [
            sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path <https://permitgraph.dev/spec/model/core/confidence> ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path <https://permitgraph.dev/spec/model/core/unit> ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <https://permitgraph.dev/spec/model/core/id> ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path <https://permitgraph.dev/spec/model/core/value_typed> ;
        ] ,
        [
            sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path <https://permitgraph.dev/spec/model/core/effective_to> ;
        ] ,
        [
            sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path <https://permitgraph.dev/spec/model/core/effective_from> ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path <https://permitgraph.dev/spec/model/core/subject_ref> ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path <https://permitgraph.dev/spec/model/core/source> ;
        ] ,
        [
            sh:class <https://permitgraph.dev/spec/model/core/AttributeDefinition> ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path <https://permitgraph.dev/spec/model/core/attribute> ;
        ] ;
    sh:targetClass <https://permitgraph.dev/spec/model/core/Fact> ;
.

<https://permitgraph.dev/spec/model/core/RollupRule>
    a sh:NodeShape ;
    rdfs:comment "How a code at a wider scope derives from a narrower one, as data. Encoding this as rows is what lets one regime forbid the roll-up that another requires." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property 
        [
            sh:in (
                "business"
                "establishment"
                "process"
                "activity"
            ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 2 ;
            sh:path <https://permitgraph.dev/spec/model/core/source_scope> ;
        ] ,
        [
            sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path <https://permitgraph.dev/spec/model/core/no_default_from_parent> ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path <https://permitgraph.dev/spec/model/core/authority_citation> ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <https://permitgraph.dev/spec/model/core/id> ;
        ] ,
        [
            sh:in (
                "largest_receipts"
                "largest_payroll"
                "operator_designated"
                "union_all"
                "none"
            ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 3 ;
            sh:path <https://permitgraph.dev/spec/model/core/method> ;
        ] ,
        [
            sh:class <https://permitgraph.dev/spec/model/core/Regime> ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path <https://permitgraph.dev/spec/model/core/regime> ;
        ] ,
        [
            sh:in (
                "business"
                "establishment"
                "process"
                "activity"
            ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path <https://permitgraph.dev/spec/model/core/target_scope> ;
        ] ;
    sh:targetClass <https://permitgraph.dev/spec/model/core/RollupRule> ;
.

<https://permitgraph.dev/spec/model/core/Activity>
    a sh:NodeShape ;
    rdfs:comment "A line of business carried on at an establishment." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property 
        [
            sh:datatype xsd:boolean ;
            sh:description "Deliberately NOT uniquely constrained. Some programmes speak of \"primary industrial activity(ies)\" in the plural, and an activity matching a narrative category is primary regardless of its code." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path <https://permitgraph.dev/spec/model/core/is_primary> ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <https://permitgraph.dev/spec/model/core/id> ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "receipts, headcount, production_rate, operator_designated, narrative_category" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path <https://permitgraph.dev/spec/model/core/primacy_basis> ;
        ] ,
        [
            sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path <https://permitgraph.dev/spec/model/core/receipts_share> ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Receipts ordering is stored as advisory guidance with an operator-supplied justification, never as an enforced rule." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path <https://permitgraph.dev/spec/model/core/primacy_justification_text> ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path <https://permitgraph.dev/spec/model/core/description> ;
        ] ,
        [
            sh:class <https://permitgraph.dev/spec/model/core/Establishment> ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path <https://permitgraph.dev/spec/model/core/establishment> ;
        ] ;
    sh:targetClass <https://permitgraph.dev/spec/model/core/Activity> ;
.

<https://permitgraph.dev/spec/model/core/BusinessEntity>
    a sh:NodeShape ;
    rdfs:comment "A legal entity. The company scope." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property 
        [
            sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path <https://permitgraph.dev/spec/model/core/formation_date> ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <https://permitgraph.dev/spec/model/core/id> ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "LLC, corporation, sole proprietorship, partnership." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path <https://permitgraph.dev/spec/model/core/entity_form> ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path <https://permitgraph.dev/spec/model/core/legal_name> ;
        ] ,
        [
            sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path <https://permitgraph.dev/spec/model/core/company_annual_receipts> ;
        ] ,
        [
            sh:datatype xsd:integer ;
            sh:description "Peak employment across the ENTIRE company in the prior calendar year. Deliberately named with a company scope, because size-based exemptions are company-wide while industry-based exemptions are per-site." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path <https://permitgraph.dev/spec/model/core/company_peak_employment_prior_cy> ;
        ] ,
        [
            sh:class <https://permitgraph.dev/spec/model/core/Establishment> ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path <https://permitgraph.dev/spec/model/core/establishments> ;
        ] ,
        [
            sh:class <https://permitgraph.dev/spec/model/core/Jurisdiction> ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path <https://permitgraph.dev/spec/model/core/formation_jurisdiction> ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:description "Affiliate grouping, which size standards aggregate across." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path <https://permitgraph.dev/spec/model/core/affiliation_group_id> ;
        ] ;
    sh:targetClass <https://permitgraph.dev/spec/model/core/BusinessEntity> ;
.

<https://permitgraph.dev/spec/model/core/ChemicalHolding>
    a sh:NodeShape ;
    rdfs:comment "A chemical held at a process. Data class is restricted." ;
    sh:closed true ;
    sh:ignoredProperties (
