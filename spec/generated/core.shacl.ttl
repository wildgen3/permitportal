<https://permitgraph.dev/spec/model/core/Requirement>
    a sh:NodeShape ;
    rdfs:comment "A reified condition between a credential and what it demands. A table rather than a foreign key, because the edge carries jurisdiction, residency, experience, cost, and dates. Recursive: AND groups contain OR alternative sets contain further groups, which is what real licensing paths need." ;
    sh:closed true ;
    sh:ignoredProperties (
        rdf:type
    ) ;
    sh:property 
        [
            sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path <https://permitgraph.dev/spec/model/core/residency_required> ;
        ] ,
        [
            sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path <https://permitgraph.dev/spec/model/core/effective_from> ;
        ] ,
        [
            sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path <https://permitgraph.dev/spec/model/core/effective_to> ;
        ] ,
        [
            sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path <https://permitgraph.dev/spec/model/core/years_experience> ;
        ] ,
        [
            sh:class <https://permitgraph.dev/spec/model/core/LegalSource> ;
