        ] ,
        [
            sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path <https://permitgraph.dev/spec/model/core/max_quantity> ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <https://permitgraph.dev/spec/model/core/id> ;
