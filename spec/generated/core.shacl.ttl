<https://permitgraph.dev/spec/model/core/ClassificationAssignment>
    a sh:NodeShape ;
    rdfs:comment "A candidate or confirmed code for a subject. Candidates are presented ranked for human confirmation; only a confirmed assignment may be the code of record." ;
